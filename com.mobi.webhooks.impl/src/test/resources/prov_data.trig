<http://mobi.com/ontologies/prov> {
  <http://mobi.com/ontologies/prov> a <http://www.w3.org/2002/07/owl#Ontology>;
    <http://www.w3.org/2002/07/owl#versionIRI> <http://mobi.com/ontologies/prov#1.0>;
    <http://www.w3.org/2002/07/owl#imports> <http://www.w3.org/ns/prov#>;
    <http://www.w3.org/2000/01/rdf-schema#label> "The Mobi Provenance Ontology"@en;
    <http://www.w3.org/2000/01/rdf-schema#comment> "The Mobi Provenance ontology describes specific types of PROV-O Activities for the application."@en;
    <http://purl.org/dc/terms/creator> _:06e6cc006cc84635b3f87a302a0b2aa22;
    <http://xmlns.com/foaf/0.1/maker> _:06e6cc006cc84635b3f87a302a0b2aa23;
    <http://purl.org/dc/terms/modified> "2017-08-02"^^<http://www.w3.org/2001/XMLSchema#date> .
  
  _:06e6cc006cc84635b3f87a302a0b2aa22 <http://xmlns.com/foaf/0.1/name> "Megan Mercer" .
  
  _:06e6cc006cc84635b3f87a302a0b2aa23 <http://xmlns.com/foaf/0.1/name> "Mobi";
    <http://xmlns.com/foaf/0.1/homepage> <https://mobi.inovexcorp.com/> .
  
  <http://mobi.com/ontologies/prov#actionWord> a <http://www.w3.org/2002/07/owl#AnnotationProperty>,
      <http://www.w3.org/2002/07/owl#FunctionalProperty>;
    <http://www.w3.org/2000/01/rdf-schema#domain> <http://www.w3.org/ns/prov#Activity>;
    <http://purl.org/dc/terms/title> "Activity Action"@en;
    <http://purl.org/dc/terms/description> "The action word associated with the Activity type"@en .
  
  <http://mobi.com/ontologies/prov#provAction> a <http://www.w3.org/2002/07/owl#FunctionalProperty>,
      <http://www.w3.org/2002/07/owl#ObjectProperty>;
    <http://www.w3.org/2000/01/rdf-schema#domain> <http://www.w3.org/ns/prov#Activity>;
    <http://purl.org/dc/terms/title> "Prov Action"@en;
    <http://purl.org/dc/terms/description> "The prov action associated with the Activity type"@en .
  
  <http://mobi.com/ontologies/prov#CreateActivity> a <http://www.w3.org/2002/07/owl#Class>;
    <http://mobi.com/ontologies/prov#actionWord> "created"@en;
    <http://purl.org/dc/terms/title> "Create Activity"@en;
    <http://purl.org/dc/terms/description> "A CreateActivity represents an event that caused the creation of a new resource. An example would be creating a new Record."@en;
    <http://mobi.com/ontologies/prov#provAction> <http://www.w3.org/ns/prov#generated>;
    <http://www.w3.org/2000/01/rdf-schema#subClassOf> <http://www.w3.org/ns/prov#Activity> .
  
  <http://mobi.com/ontologies/prov#DeleteActivity> a <http://www.w3.org/2002/07/owl#Class>;
    <http://mobi.com/ontologies/prov#actionWord> "deleted"@en;
    <http://purl.org/dc/terms/title> "Delete Activity"@en;
    <http://purl.org/dc/terms/description> "A DeleteActivity represents an event that caused the deletion of a resource. An example would be deleting a Record."@en;
    <http://mobi.com/ontologies/prov#provAction> <http://www.w3.org/ns/prov#invalidated>;
    <http://www.w3.org/2000/01/rdf-schema#subClassOf> <http://www.w3.org/ns/prov#Activity> .
  
  <http://mobi.com/ontologies/prov#UpdateActivity> a <http://www.w3.org/2002/07/owl#Class>;
    <http://mobi.com/ontologies/prov#actionWord> "updated"@en;
    <http://purl.org/dc/terms/title> "Update Activity"@en;
    <http://purl.org/dc/terms/description> "An UpdateActivity represents an event that caused a resource to be updated. An example would be when a Record's metadata is updated."@en;
    <http://mobi.com/ontologies/prov#provAction> <http://www.w3.org/ns/prov#used>;
    <http://www.w3.org/2000/01/rdf-schema#subClassOf> <http://www.w3.org/ns/prov#Activity> .
  
  <http://mobi.com/ontologies/prov#UseActivity> a <http://www.w3.org/2002/07/owl#Class>;
    <http://mobi.com/ontologies/prov#actionWord> "used"@en;
    <http://purl.org/dc/terms/title> "Utilization Activity"@en;
    <http://purl.org/dc/terms/description> "A UseActivity represents an event where a resource was utilized in some process. An example would be when a Mapping is run against some data."@en;
    <http://mobi.com/ontologies/prov#provAction> <http://www.w3.org/ns/prov#used>;
    <http://www.w3.org/2000/01/rdf-schema#subClassOf> <http://www.w3.org/ns/prov#Activity> .
  
  <http://mobi.com/ontologies/prov#SystemActivity> a <http://www.w3.org/2002/07/owl#Class>;
    <http://mobi.com/ontologies/prov#actionWord> "interacted with"@en;
    <http://purl.org/dc/terms/title> "System Activity"@en;
    <http://purl.org/dc/terms/description> "A SystemActivity represents an event relating to the application as a whole. Examples would be when a user logs in or data is uploaded through the admin command line."@en;
    <http://mobi.com/ontologies/prov#provAction> <http://www.w3.org/ns/prov#used>;
    <http://www.w3.org/2000/01/rdf-schema#subClassOf> <http://www.w3.org/ns/prov#Activity> .
}
