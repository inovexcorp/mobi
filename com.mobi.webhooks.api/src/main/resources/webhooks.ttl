@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix foaf: <http://xmlns.com/foaf/0.1/>.
@prefix dct: <http://purl.org/dc/terms/>.
@prefix mcat: <http://mobi.com/ontologies/catalog#>.
@prefix : <http://mobi.solutions/ontologies/webhooks#>.
@base <http://mobi.solutions/ontologies/webhooks>.

<http://mobi.solutions/ontologies/webhooks> a owl:Ontology;
    owl:versionIRI <http://mobi.solutions/ontologies/webhooks#1.0>;
    owl:imports <http://mobi.com/ontologies/catalog>;
    rdfs:label "The Mobi Webhooks Ontology"@en;
    rdfs:comment "The Mobi webhooks ontology is designed to facilitate webhook configuration and management within the Mobi platform."@en;
    dct:creator [foaf:name "Mobi Development Team"];
    foaf:maker [foaf:name "Mobi"; foaf:homepage <https://mobi.inovexcorp.com/>];
    dct:modified "2026-03-12"^^xsd:date.

# Webhook Record

:WebhookRecord a owl:Class;
    rdfs:subClassOf mcat:UnversionedRecord;
    rdfs:label "Webhook Record"@en;
    rdfs:comment "An unversioned catalog record that represents a webhook configuration for sending HTTP callbacks in response to platform events."@en.

:hasWebhookConfiguration a owl:ObjectProperty, owl:FunctionalProperty;
    rdfs:label "has webhook configuration"@en;
    rdfs:comment "Links a Webhook Record to its configuration."@en;
    rdfs:domain :WebhookRecord;
    rdfs:range :WebhookConfiguration.

# Webhook Configuration

:WebhookConfiguration a owl:Class;
    rdfs:label "Webhook Configuration"@en;
    rdfs:comment "Configuration details for a webhook including URL, authentication, and event triggers."@en.

:url a owl:DatatypeProperty, owl:FunctionalProperty;
    rdfs:label "url"@en;
    rdfs:comment "The URL endpoint where webhook events will be sent."@en;
    rdfs:domain :WebhookConfiguration;
    rdfs:range xsd:string.

:httpMethod a owl:DatatypeProperty, owl:FunctionalProperty;
    rdfs:label "http method"@en;
    rdfs:comment "The HTTP method to use when sending webhook requests (e.g., POST, PUT)."@en;
    rdfs:domain :WebhookConfiguration;
    rdfs:range xsd:string.

:eventFilter a owl:DatatypeProperty;
    rdfs:label "event filter"@en;
    rdfs:comment "Optional filter string to specify which events should trigger the webhook."@en;
    rdfs:domain :WebhookConfiguration;
    rdfs:range xsd:string.

:active a owl:DatatypeProperty, owl:FunctionalProperty;
    rdfs:label "active"@en;
    rdfs:comment "Indicates whether the webhook is currently active and enabled."@en;
    rdfs:domain :WebhookConfiguration;
    rdfs:range xsd:boolean.

:secretToken a owl:DatatypeProperty;
    rdfs:label "secret token"@en;
    rdfs:comment "Optional secret token used for authenticating webhook requests."@en;
    rdfs:domain :WebhookConfiguration;
    rdfs:range xsd:string.

:hasRequestHeader a owl:ObjectProperty;
    rdfs:label "has request header"@en;
    rdfs:comment "Links a Webhook Configuration to HTTP request headers."@en;
    rdfs:domain :WebhookConfiguration;
    rdfs:range :RequestHeader.

# Request Header

:RequestHeader a owl:Class;
    rdfs:label "Request Header"@en;
    rdfs:comment "An HTTP header key-value pair to be included in webhook requests."@en.

:hasHeaderName a owl:DatatypeProperty, owl:FunctionalProperty;
    rdfs:label "header name"@en;
    rdfs:comment "The key/name of the HTTP header."@en;
    rdfs:domain :RequestHeader;
    rdfs:range xsd:string.

:hasHeaderValue a owl:DatatypeProperty, owl:FunctionalProperty;
    rdfs:label "header value"@en;
    rdfs:comment "The value of the HTTP header."@en;
    rdfs:domain :RequestHeader;
    rdfs:range xsd:string.

